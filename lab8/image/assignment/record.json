                        "g_2": 1.666667,
                        "g_3": 1.666667,
                        "b_1": 3,
                        "b_2": 2,
                        "b_3": 1,
                        "C_in": 8,
                        "C_L": 45,
                        "f_hat": 5,
                        "p_1": 2,
                        "p_2": 3,
                        "p_3": 2,
                        "t_inv": 14.623,
                        "t_pLH": 311.857,
                        "t_pHL": 373.492,
                        "T_theor": 321.706,
                        "T_prac": 342.6745
                    },
                    "items": [
                        "G = g_1 * g_2 * g_3 | round: 4",
                        "B = b_1 * b_2 * b_3 | round: 0",
                        "H = C_L / C_in | round: 3",
                        "F = G * B * H | round: 0",
                        "f_{hat} = 5",
                        "x = (f_hat * C_in) / (g_1 * b_1) | round: 0",
                        "y = (f_hat * x) / (g_2 * b_2) | round: 0",
                        "P = p_1 + p_2 + p_3 | round: 0",
                        "D = 3 * f_hat + P | round: 0",
                        "T_{theor} = D * t_inv | unit: ps | round: 4",
                        "T_{prac} = (t_pLH + t_pHL) / 2 | unit: ps | round: 4",
                        "Error = (T_prac - T_theor) / T_theor * 100 | unit: % | round: 2"
                    ]
                },
