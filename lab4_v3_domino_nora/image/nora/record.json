                        "$V_{TH}=720.63mV$",
                        "$NM_H=V_{OH}-V_{IH}=1800-836.611=963.389mV$",
                        "$NM_L=V_{IL}-V_{OL}=685.21-0=685.21mV$",
                        "$t_{PHL}=23.1036-23.0025=0.1011ns=101.1ps$",
                        "$t_{PLH}=0ns$",
                        "$t_r=25.0887-25.0175=0.0712ns=71.2ps$",
                        "$t_f=23.1233-23.0851=0.0382ns=38.2ps$",
