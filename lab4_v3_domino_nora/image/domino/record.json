                            "title": "Performance parameters of Dynamic CMOS Domino Inverter",
                            "csv": "domino.csv"
                        }
                    ]
                },
                {
                    "type": "text",
                    "number": 5,
                    "title": "CALCULATION for transmission gate based d flip flop",
                    "new_page": false,
                    "text": [
                        "For the Dynamic CMOS Domino Inverter:",
                        "$V_{TH}=718.473mV$",
                        "$NM_H=V_{OH}-V_{IH}=1800-836.611=963.389mV$",
                        "$NM_L=V_{IL}-V_{OL}=685.147-0=685.147mV$",
                        "$t_{PHL}=31.2133-31.125=0.0883ns=88.3ps$",
                        "$t_{PLH}=0ns$",
                        "$t_r=33.2219-33.1463=0.0756ns=75.6ps$",
                        "$t_f=31.2306-31.1991=0.0315ns=31.5ps$",
                        "For the 2-input NAND Gate:",
