{
    "name": "vd",
    "page": {
        "size": "A4",
        "margin": {
            "top": 20,
            "bottom": 20,
            "left": 22,
            "right": 22
        }
    },
    "fonts": {
        "body": "Times-Roman",
        "heading": "Helvetica-Bold",
        "title": "Helvetica-Bold",
        "caption": "Helvetica-Bold",
        "header": "Helvetica-Bold",
        "code": "Courier"
    },
    "font_sizes": {
        "header": 11,
        "experiment_title": 14,
        "section_heading": 12,
        "body": 11,
        "table_cell": 9.5,
        "table_header": 9.5,
        "caption": 10
    },
    "experiment_header": {
        "font_size": 14,
        "student_offset_y": 8,
        "exp_no_offset_y": 8,
        "date_offset_y": -2,
        "rule_offset_y": -6,
        "spacing_after": 14,
        "show_date": true,
        "show_rule": true,
        "layout_style": "centered"
    },
    "paragraph": {
        "line_spacing": 1.25,
        "spacing_after": 4,
        "spacing_before": 0
    },
    "table": {
        "number_format": "Table {section_num}.{table_num}: {title}",
        "numbering_style": "section_based",
        "font_size": 9.5,
        "border_width": 0.5,
        "cell_padding": 3.5,
        "header_bold": true,
        "header_background": "#ffffff",
        "spacing_after": 6
    },
    "figure": {
        "number_format": "Figure {section_num}.{figure_num}: {title}",
        "numbering_style": "section_based"
    },
    "image": {
        "default_gap": 5,
        "caption_font_size": 10,
        "caption_spacing": 4,
        "alignment": "center"
    },
    "header": {
        "show_header": true,
        "rule": true
    }
}
